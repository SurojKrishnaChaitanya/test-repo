# ====================================================================
# INDRA-AI Atmospheric Nowcasting Frontend - Environment Configuration
# ====================================================================

# Enable live backend model inference
VITE_USE_REAL_MODEL=true

# Proxied API Routes (Routed through Vercel serverless proxy or Vite dev proxy)
VITE_API_PROXY_URL=/api/v1/indra-ai
VITE_ML_MODEL_API_URL=/api/v1/indra-ai
VITE_ALERTING_API_URL=/api/v1/indra-ai
VITE_USE_REAL_ALERTS=true

# Production Render Backend URL (Configure this in your Vercel Project Settings)
# Example: https://indra-backend.onrender.com
RENDER_BACKEND_URL=https://indra-backend.onrender.com

# WebSocket Telemetry Stream (Optional)
VITE_ML_MODEL_WS_URL=wss://indra-backend.onrender.com/ws/nowcast

# Build Settings
GENERATE_SOURCEMAP=false

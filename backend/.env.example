# ====================================================================
# INDRA-AI High-Resolution Severe Weather Nowcasting Engine - Backend Config
# ====================================================================

# Port for FastAPI uvicorn server (Render automatically sets $PORT)
PORT=8000

# Service deployment type: production / development
RENDER_SERVICE_TYPE=production

# Enterprise Model Architecture & Compute Metadata
MODEL_ARCHITECTURE=Earthformer-ConvLSTM-DGMR-DualTask
INFERENCE_ENGINE=TensorRT-LLM-Triton-V2.4
SPATIAL_RESOLUTION=3km_EPSG4326_LCC
TEMPORAL_WINDOW=t-6h_to_t+6h_step30m
COMPUTE_NODE=hf-dgx-a100-mig-3g.40gb

# Allowed CORS Origins (handled by Enterprise middleware)
CORS_ORIGINS=*
